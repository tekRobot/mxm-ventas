# Copia este archivo como .env y completa los valores según el entorno
# (desarrollo local o producción). .env NO se sube al repositorio.

# URL base para llamadas a la API (incluye hasta antes del nombre del endpoint)
VITE_API_BASE_URL=https://tu-servidor/CarritoWeb/APICarrito

# URL base para imágenes servidas por el backend
VITE_IMAGE_BASE_URL=https://tu-servidor/CarritoWeb
